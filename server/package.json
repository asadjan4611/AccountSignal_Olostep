    "multer": "^2.5.0",
    "p-limit": "^7.3.3",
    "papaparse": "^5.7.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "tldts": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
